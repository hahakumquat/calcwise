---
/**
 * Ad placement. Renders nothing unless PUBLIC_ADSENSE_CLIENT is set at build time,
 * so the site ships clean by default. Set PUBLIC_AD_SLOT_<NAME> to an AdSense slot id per placement.
 */
import { SITE } from '../lib/site';
interface Props {
  name: 'below-calc' | 'sidebar' | 'in-content';
}
const { name } = Astro.props;
const slot = (import.meta.env as Record<string, string | undefined>)[`PUBLIC_AD_SLOT_${name.replace('-', '_').toUpperCase()}`];
---
{SITE.adsenseClient && slot && (
  <div class="ad-wrap">
    <ins class="adsbygoogle" style="display:block" data-ad-client={SITE.adsenseClient} data-ad-slot={slot} data-ad-format="auto" data-full-width-responsive="true"></ins>
    <script is:inline>(window.adsbygoogle = window.adsbygoogle || []).push({});</script>
  </div>
)}
<style>
  .ad-wrap {
    margin-block: 24px;
    min-height: 100px;
  }
</style>
