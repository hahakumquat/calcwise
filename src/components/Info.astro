---
interface Props {
  text?: string;
  label: string;
}
const { text, label } = Astro.props;
---
{text && (
  <button type="button" class="info-btn" data-tip={text} aria-label={`What is “${label}”?`} aria-expanded="false">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="9" /><path d="M12 11v5M12 7.6v.1" /></svg>
  </button>
)}
